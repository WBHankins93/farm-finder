# State directories contain only the seven-file contract. These generated evidence
# names belong under data/source-releases/ and are also rejected by the validator.
research/state-expansions/*/raw-source-records*
research/state-expansions/*/*source-observations*
research/state-expansions/*/*candidate-entities.json
research/state-expansions/*/request-log*
