# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!infra/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# Curated farm photography is licensed for local design review and is not
# committed. Source records and intended placements live in docs/design/.
/public/local-farm-images/

# Generated runtime artifacts (regenerate: python3 scripts/build-web-feed.py)
public/national-index.bin
app/data/directory-stats.generated.json
# Rollback-explorer feed only; too large to deploy (FARMFINDER_LEGACY_FEED=1)
public/farms.json
