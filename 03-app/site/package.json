{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "db:up": "docker compose -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:reset": "sh infra/reset-db.sh",
    "db:verify": "sh infra/verify-db.sh",
    "db:test": "sh infra/test-db.sh",
    "data:setup": "python3 -m venv .venv && .venv/bin/python -m pip install -r scripts/requirements.txt",
    "data:validate": ".venv/bin/python scripts/validate-source-of-truth.py",
    "states:validate": ".venv/bin/python ../../01-database/tools/validate_state_releases.py",
    "states:status": ".venv/bin/python ../../01-database/tools/state_release_status.py AL TX",
    "states:test": ".venv/bin/python -m unittest discover -s ../../01-database/tools/tests -p 'test_*.py'",
    "pr:assess": ".venv/bin/python ../../01-database/tools/assess_pr_scope.py",
    "cutover:test": "PYTHONPATH=scripts .venv/bin/python -m unittest discover -s scripts/tests -p 'test_*.py'",
    "cutover:stage": ".venv/bin/python scripts/stage_source_release.py",
    "cutover:verify": ".venv/bin/python scripts/verify_staged_release.py",
    "cutover:local": "npm run infra:up && npm run data:validate && npm run cutover:test && npm run cutover:stage && npm run cutover:verify"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
